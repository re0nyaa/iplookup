<!doctype html>
<html lang="ko">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>IP Lookup — Network Intelligence</title>
    <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <link rel="stylesheet" href="/css/style.css" />
</head>

<body>
    <div class="shell">
        <main class="main">
            <section class="hero" aria-label="아이피 정보">
                <span class="label">Public IP Address</span>
                <div class="ip-row">
                    <h1 class="ip" id="ipDisplay">
                        <%= countryData?.ip %>
                    </h1>
                    <button type="button" class="text-btn" id="copyBtn">
                        <span id="copyText">복사</span>
                    </button>
                </div>
                <p class="desc">
                    현재 위치는
                    <strong id="countrySummary">
                        <%= countryData?.country_name ?? "Unknown" %> (<%= countryData?.country_code ?? "--" %>)
                    </strong>
                    입니다.
                </p>
            </section>

            <form class="search-bar" id="lookupForm">
                <input type="text" id="ipInput" class="search-input" placeholder="조회할 IP 주소 입력 (예: 1.1.1.1)"
                    autocomplete="off" />
                <button type="submit" class="text-btn">조회</button>
                <button type="button" id="resetBtn" class="text-btn hidden">초기화</button>
            </form>

            <div id="errorBox" class="error-msg hidden"></div>

            <section class="data-list" aria-label="상세 네트워크 정보">
                <div class="data-row">
                    <span class="data-key">국가 / 지역</span>
                    <span class="data-val" id="metaCountry">
                        <%= countryData?.country_name ?? "Unknown" %> (<%= countryData?.country_code ?? "--" %> · <%=
                                    countryData?.continent ?? "--" %>)
                    </span>
                </div>
                <div class="data-row">
                    <span class="data-key">네트워크 (ASN)</span>
                    <span class="data-val" id="metaOrg"><%- `${countryData?.org ?? "Unknown"} (${countryData?.asn && countryData?.asn !== "--" ? `<a href="https://radar.cloudflare.com/ko-kr/traffic/as${String(countryData.asn).replace(/^AS/i, "")}" target="_blank" rel="noopener">AS${String(countryData.asn).replace(/^AS/i, "")}</a>` : "--"})` %></span>
                </div>
                <div class="data-row">
                    <span class="data-key">라우팅 대역</span>
                    <span class="data-val" id="metaRoute">
                        <%= countryData?.route ?? "--" %>
                    </span>
                </div>
                <div class="data-row">
                    <span class="data-key">도메인</span>
                    <span class="data-val" id="metaDomain"><%- countryData?.domain && countryData?.domain !== "--" ? `<a href="https://${countryData.domain}" target="_blank" rel="noopener">${countryData.domain}</a>` : "--" %></span>
                </div>
            </section>
        </main>

        <footer class="footer">
            <div>
                Powered by
                <a href="https://iplocate.io" target="_blank" rel="noopener">IPLocate.io</a>
                · <a href="https://renyaa.com" target="_blank" rel="noopener">Renyaa</a>
            </div>
            <div>
                <a href="/api/ip/<%= countryData?.ip %>" id="apiLink" target="_blank" rel="noopener">JSON</a>
            </div>
        </footer>
    </div>

    <script src="/js/main.js" defer></script>
</body>

</html>