<!doctype html>
<html lang="ko">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>내 IP 주소 확인 및 네트워크 조회 — ip.eiv.me</title>
    <meta name="description" content="접속 중인 내 공인 IP 주소, 국가, ISP, ASN, CIDR 서브넷 대역을 실시간으로 확인하고 다른 IP 주소를 간편하게 조회할 수 있는 고속 네트워크 인텔리전스 도구입니다." />
    <meta name="keywords" content="내 아이피 확인, ip 확인, 내 ip 주소, ip 조회, ip lookup, asn 조회, 네트워크 조회, ip.eiv.me" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://ip.eiv.me/" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://ip.eiv.me/" />
    <meta property="og:site_name" content="ip.eiv.me" />
    <meta property="og:title" content="내 IP 주소 확인 및 네트워크 조회 — ip.eiv.me" />
    <meta property="og:description" content="접속 중인 내 공인 IP 주소, 국가, 통신사(ISP), ASN, 네트워크 대역을 실시간으로 확인하고 조회하세요." />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:url" content="https://ip.eiv.me/" />
    <meta name="twitter:title" content="내 IP 주소 확인 및 네트워크 조회 — ip.eiv.me" />
    <meta name="twitter:description" content="접속 중인 내 공인 IP 주소, 국가, 통신사(ISP), ASN, 네트워크 대역을 실시간으로 확인하고 조회하세요." />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "ip.eiv.me",
      "url": "https://ip.eiv.me/",
      "description": "내 공인 IP 주소 확인 및 실시간 네트워크 인텔리전스 조회 도구",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0"
      }
    }
    </script>

    <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <link rel="stylesheet" href="/css/style.css" />
</head>

<body>
    <div class="shell">
        <main class="main">
            <section class="hero" aria-label="아이피 정보">
                <div class="ip-row">
                    <h1 class="ip" id="ipDisplay">
                        <%= countryData?.ip %>
                    </h1>
                    <button type="button" class="text-btn" id="copyBtn">
                        <span id="copyText">복사</span>
                    </button>
                </div>
                <p class="desc">
                    현재 위치는
                    <strong id="countrySummary">
                        <%= countryData?.country_name ?? "Unknown" %> (<%= countryData?.country_code ?? "--" %>)
                    </strong>
                    입니다.
                </p>
            </section>

            <form class="search-bar" id="lookupForm">
                <input type="text" id="ipInput" class="search-input" placeholdeyar="조회할 IP 주소 입력 (예: 1.1.1.1)"
                    autocomplete="off" />
                <button type="submit" class="text-btn">조회</button>
                <button type="button" id="resetBtn" class="text-btn hidden">초기화</button>
            </form>

            <div id="errorBox" class="error-msg hidden"></div>

            <section class="data-list" aria-label="상세 네트워크 정보">
                <div class="data-group">
                    <span class="group-title">Location</span>
                    <div class="data-row">
                        <span class="data-key">국가 / 지역</span>
                        <span class="data-val" id="metaCountry"><%= countryData?.country_name ?? "Unknown" %> (<%= countryData?.country_code ?? "--" %> · <%= countryData?.continent ?? "--" %>)</span>
                    </div>
                </div>

                <div class="data-group">
                    <span class="group-title">Network & ASN</span>
                    <div class="data-row">
                        <span class="data-key">ASN 정보</span>
                        <span class="data-val" id="metaAsn"><%- `${countryData?.asn_name ?? "--"} (${countryData?.asn && countryData?.asn !== "--" ? `<a href="https://radar.cloudflare.com/ko-kr/traffic/as${String(countryData.asn).replace(/^AS/i, "")}" target="_blank" rel="noopener">AS${String(countryData.asn).replace(/^AS/i, "")}</a>` : "--"})` %></span>
                    </div>
                    <div class="data-row">
                        <span class="data-key">운영 기관</span>
                        <span class="data-val" id="metaAsnOrg"><%= countryData?.asn_org ?? "Unknown" %></span>
                    </div>
                    <div class="data-row">
                        <span class="data-key">ASN 등록 국가</span>
                        <span class="data-val" id="metaAsnCountry"><%= countryData?.asn_country ?? "--" %></span>
                    </div>
                    <div class="data-row">
                        <span class="data-key">네트워크 대역</span>
                        <span class="data-val" id="metaNetwork"><%= countryData?.network ?? "--" %></span>
                    </div>
                    <div class="data-row">
                        <span class="data-key">도메인</span>
                        <span class="data-val" id="metaDomain"><%- countryData?.domain && countryData?.domain !== "--" ? `<a href="https://${countryData.domain}" target="_blank" rel="noopener">${countryData.domain}</a>` : "--" %></span>
                    </div>
                </div>
            </section>
        </main>

        <footer class="footer">
            <div class="footer-meta">
                <span>Copyright &copy; EIV <%= new Date().getFullYear() %>. All Rights Reserved.</span>
                <span class="footer-divider">·</span>
                <span>Powered by <a href="https://iplocate.io" target="_blank" rel="noopener">IPLocate.io</a> · <a href="https://eiv.me" target="_blank" rel="noopener">EIV</a></span>
            </div>
            <div>
                <a href="/api/ip/<%= countryData?.ip %>" id="apiLink" target="_blank" rel="noopener">JSON</a>
            </div>
        </footer>
    </div>

    <script src="/js/main.js" defer></script>
</body>

</html>